---
import '../home/infrastructure/ui/styles/boot.css';
import '../styles/variables-css/_colors.scss';
import SiteHead from '../components/SiteHead.astro';
import WorkSection from '../components/WorkSection.astro';
import WorkSectionV2 from '../components/WorkSectionV2.astro';
import CertificationsSection from '../components/CertificationsSection.astro';
import ContactSection from '../components/ContactSection.astro';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&family=VT323&display=swap" rel="stylesheet">
  </head>
  <body style="margin:0; background:#000; overflow:hidden;">
    <div id="boot-screen" class="boot-screen">
      <div id="boot-output" class="boot-output"></div>
    </div>

    <button id="skip-btn" class="skip-btn">&gt;&gt; SKIP</button>

    <div id="video-container" style="display:none; position:fixed; inset:0; z-index:50; background:#000;">
      <video id="staticVideo" src="/Static_Screen.mp4" muted autoplay playsinline style="width:100%; height:100%; object-fit:cover;"></video>
    </div>

    <div id="model-container" style="display:none; position:fixed; inset:0; z-index:75;"></div>

    <div id="sitehead-container" style="display:none;">
      <SiteHead />
    </div>

    <div id="portfolio-title" style="display:none; margin-top:40px; padding-left:5%; background:#fff; color:#1f1f1f; font-family: 'Ubuntu', monospace; font-weight: 800; letter-spacing:.15em;">
      <div id="title-line" style="display:flex; align-items:baseline; gap:15rem;">
        <div id="title-text" style="font-size:clamp(3.5rem,9.5vw,7.5rem); font-weight: 900; height: 0.4em; min-height: 1em; line-height:1; overflow:hidden;"></div>
        <div id="title-sub" style="font-size:clamp(1.25rem,2.5vw,1.75rem); font-weight:700; height: 0.4em; min-height: 1em; line-height:1; overflow:hidden; color:#1f1f1f;"></div>
      </div>
      <div id="title-text-2" style="font-size:clamp(3.5rem,9.5vw,7.5rem); font-weight: 900; height: 0.4em; min-height: 1em; line-height:1; overflow:hidden;"></div>
      <div id="title-title" style="font-size:clamp(3.5rem,9.5vw,7.5rem); font-weight: 900; height: 0.4em; min-height: 1em; line-height:1; overflow:hidden; color:#8a0606;"></div>

      <div id="title-phrase" style="font-size:clamp(3.75rem,6vw,4.5rem); font-style: italic; font-weight: 600; overflow:hidden; height: 0.4em; min-height: 1em; line-height:1; margin-top: 0.5rem;"></div>
      <div id="title-phrase-2" style="font-size:clamp(3.75rem,6vw,4.5rem); font-style: italic; font-weight: 600; overflow:hidden; height: 0.4em; min-height: 1em; line-height:1; margin-top: 0.5rem;"></div>
      <div id="title-autor" style="font-size:clamp(3.55rem,5.7vw,4.3rem); font-style: italic; font-weight: 600; overflow:hidden; height: 0.4em; min-height: 1em; line-height:1; margin-top: 0.5rem;"></div>
    </div>

    <div id="work-wrapper" style="display:none;">
      <WorkSection />
      <WorkSectionV2 />
    </div>

    <div id="certifications-wrapper" style="display:none;">
      <CertificationsSection />
    </div>

    <div id="contact-wrapper" style="display:none;">
      <ContactSection />
    </div>

    <div id="white-top" style="position:fixed; top:0; left:0; right:0; height:0; background:#fff; z-index:100;"></div>
    <div id="white-bottom" style="position:fixed; bottom:0; left:0; right:0; height:0; background:#fff; z-index:100;"></div>
    <div id="white-left" style="position:fixed; left:0; top:0; bottom:0; width:0; background:#fff; z-index:100;"></div>
    <div id="white-right" style="position:fixed; right:0; top:0; bottom:0; width:0; background:#fff; z-index:100;"></div>
  </body>
</html>

<script>
  function animate(el, keyframes, options = {}) {
    const kf = Array.isArray(keyframes) ? keyframes : [{}, keyframes];
    return el.animate(kf, {
      duration: (options.duration || 0) * 1000,
      delay: (options.delay || 0) * 1000,
      easing: Array.isArray(options.easing) ? `cubic-bezier(${options.easing.join(',')})` : (options.easing || 'linear'),
      fill: 'forwards',
      iterations: options.repeat ?? 1,
    });
  }
  import('../home/infrastructure/ui/scripts/boot.js');
  import { MODELS } from '../home/application/model-viewer/config.js';
  import { initCertMurals } from '../certifications/infrastructure/ui/scripts/certMural.js';

  let __skipRunning = false;
  document.getElementById('skip-btn')?.addEventListener('click', async function () {
    if (window.__skipAnimation || __skipRunning) return;
    __skipRunning = true;
    window.__skipAnimation = true;

    const bootScreen = document.getElementById('boot-screen');
    if (bootScreen) { bootScreen.style.transition = 'none'; bootScreen.style.display = 'none'; }

    const videoContainer = document.getElementById('video-container');
    if (videoContainer) videoContainer.style.display = 'none';
    const video = document.getElementById('staticVideo');
    if (video) { video.pause(); video.src = ''; }

    ['white-top', 'white-bottom', 'white-left', 'white-right'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.style.display = 'none';
    });

    document.body.style.background = '#fff';
    document.documentElement.style.background = '#fff';

    const modelContainer = document.getElementById('model-container');
    if (modelContainer) modelContainer.style.display = 'block';
    try {
      const { initModelViewer } = await import('../home/infrastructure/ui/viewer/ModelViewer.js');
      const viewer = await initModelViewer(modelContainer, MODELS);
      window.__modelViewer = viewer;
      const vhsEffect = viewer.startVHS();
      await new Promise(r => setTimeout(r, 1000));
      viewer.stopVHS();
      if (viewer?.dispose) viewer.dispose();
    } catch (e) {}
    if (modelContainer) modelContainer.style.display = 'none';

    const titleDiv = document.getElementById('portfolio-title');
    if (titleDiv) {
      titleDiv.style.display = 'block';
      titleDiv.style.opacity = '0';
      animateTextById('title-text', 'ANDRY');
      animateTextById('title-sub', '>_AR3LYX1', 0.7, 0.15);
      animateTextById('title-text-2', 'CACERES');
      animateTextById('title-title', 'SOFTWARE DEV');
      animateTextById('title-phrase', "\"Software is like sex:", 0.28);
      animateTextById('title-phrase-2', "it's better when it's free.\"",0.28);
      animateTextById('title-autor', " - Linus Torvalds -");
      titleDiv.style.opacity = '1';
    }

    const vh = window.innerHeight * 0.01;
    document.documentElement.style.setProperty('--vh', `${vh}px`);
    window.addEventListener('resize', () => {
      const vhResize = window.innerHeight * 0.01;
      document.documentElement.style.setProperty('--vh', `${vhResize}px`);
    });
    document.body.style.overflow = 'auto';
    document.documentElement.style.overflow = 'auto';
    document.body.style.height = '';
    document.documentElement.style.height = '';

    const headContainer = document.getElementById('sitehead-container');
    if (headContainer) headContainer.style.display = 'block';
    const workEl = document.getElementById('work-wrapper');
    if (workEl) workEl.style.display = 'block';
    const certsEl = document.getElementById('certifications-wrapper');
    if (certsEl) {
      certsEl.style.display = 'block';
      setTimeout(() => {
        if (window.__adblockDetected === undefined) {
          const bait = document.createElement('div');
          bait.className = 'adsbox pub_300x250';
          bait.innerHTML = '&nbsp;';
          bait.style.cssText = 'position:absolute;left:-9999px';
          document.body.appendChild(bait);
          window.__adblockDetected = bait.offsetHeight === 0 || bait.offsetParent === null;
          bait.remove();
        }
        if (window.__adblockDetected) {
          const existing = document.getElementById('adblock-warning');
          if (!existing) {
            const warn = document.createElement('div');
            warn.id = 'adblock-warning';
            warn.style.cssText = 'padding:1rem 2rem;margin:1rem;background:#fff3cd;border:2px solid #ffc107;border-radius:8px;color:#856404;font-family:Ubuntu,monospace;font-size:0.95rem;text-align:center;';
            warn.innerHTML = '<strong>⚠ Ad Blocker Detectado</strong><br>Algunos contenidos (certificaciones) pueden no mostrarse correctamente. Desactívalo para este sitio.';
            certsEl.prepend(warn);
          }
        } else {
          import('../certifications/infrastructure/ui/scripts/certMural.js').then(m => m.initCertMurals()).catch(() => {});
        }
      }, 100);
    }
    const contactEl = document.getElementById('contact-wrapper');
    if (contactEl) contactEl.style.display = 'block';

    window.scrollTo(0, 0);
    const siteHead = document.querySelector('.site-head');
    if (siteHead) siteHead.style.opacity = '1';

    this.style.display = 'none';
  });

  function animateTextById(id, text, duration = 0.7, charDelay = 0.09) {
    const el = document.getElementById(id);
    if (!el) return;
    const content = text ?? '';
    el.innerHTML = '';
    let specialWrapper = null;
    content.split('').forEach((char, index) => {
      if (id === 'title-text' && content === 'ANDRY' && char === 'D') {
        const wrapper = document.createElement('span');
        wrapper.style.display = 'inline-flex';
        wrapper.style.alignItems = 'center';
        wrapper.style.justifyContent = 'center';
        wrapper.style.position = 'relative';
        wrapper.style.transform = 'translateY(-103%)';
        const original = document.createElement('span');
        original.innerText = 'D';
        original.style.opacity = '1';
        const replacement = document.createElement('span');
        replacement.innerText = '☾︎';
        replacement.style.position = 'absolute';
        replacement.style.inset = '0';
        replacement.style.display = 'flex';
        replacement.style.alignItems = 'center';
        replacement.style.justifyContent = 'center';
        replacement.style.opacity = '0';
        replacement.style.pointerEvents = 'none';
        original.style.lineHeight = '1';
        wrapper.appendChild(original);
        wrapper.appendChild(replacement);
        el.appendChild(wrapper);
        specialWrapper = { wrapper, original, replacement, index };
        return;
      }
      const span = document.createElement('span');
      span.innerText = char === ' ' ? '\u00A0' : char;
      span.style.display = 'inline-block';
      span.style.transform = 'translateY(-103%)';
      el.appendChild(span);
    });
    Array.from(el.children).forEach((child, index) => {
      const dropDelay = index * charDelay;
      animate(child, { transform: 'translateY(0%)' }, { duration, delay: dropDelay, easing: 'linear' });
      if (child === specialWrapper?.wrapper) {
        const { original, replacement } = specialWrapper;
        const revealDelay = dropDelay + duration + 0.15;
        const fadeDuration = 0.2;
        const visibleDuration = 0.4;
        const loopDuration = fadeDuration * 2 + visibleDuration;
        const pFadeIn = fadeDuration / loopDuration;
        const pHold = (fadeDuration + visibleDuration) / loopDuration;
        animate(original, [
          { opacity: 1, offset: 0 },
          { opacity: 0, offset: pFadeIn },
          { opacity: 0, offset: pHold },
          { opacity: 1, offset: 1 }
        ], { duration: loopDuration, delay: revealDelay, repeat: Infinity, easing: 'ease-in-out' });
        animate(replacement, [
          { opacity: 0, offset: 0 },
          { opacity: 1, offset: pFadeIn },
          { opacity: 1, offset: pHold },
          { opacity: 0, offset: 1 }
        ], { duration: loopDuration, delay: revealDelay, repeat: Infinity, easing: 'ease-in-out' });
      }
    });
  }

  function animateDrop(el, html) {
    el.innerHTML = '';
    const parts = html.split('<br>');
    parts.forEach((part, pi) => {
      if (pi > 0) el.appendChild(document.createElement('br'));
      const indent = part.startsWith('_>:');
      [...part].forEach((char, ci) => {
        const span = document.createElement('span');
        span.textContent = char === ' ' ? '\u00A0' : char;
        span.style.display = 'inline-block';
        span.style.transform = 'translateY(-103%)';
        if (ci === 0 && indent) span.style.marginLeft = '1.8em';
        el.appendChild(span);
      });
    });
    const chars = [...el.children].filter(c => c.tagName !== 'BR');
    chars.forEach((child, idx) => {
      animate(child, { transform: 'translateY(0%)' }, { duration: 0.5, delay: idx * 0.04, easing: 'linear' });
    });
  }

  window.addEventListener('bootComplete', async () => {
    const videoContainer = document.getElementById('video-container');
    const video = document.getElementById('staticVideo');
    const topPanel = document.getElementById('white-top');
    const bottomPanel = document.getElementById('white-bottom');
    const leftPanel = document.getElementById('white-left');
    const rightPanel = document.getElementById('white-right');
    const modelContainer = document.getElementById('model-container');

    if (window.__skipAnimation) {
      videoContainer.style.display = 'none';
      if (video) { video.pause(); video.src = ''; }
      topPanel.style.display = 'none';
      bottomPanel.style.display = 'none';
      leftPanel.style.display = 'none';
      rightPanel.style.display = 'none';
      document.body.style.background = '#fff';
      document.documentElement.style.background = '#fff';
    } else {
      const modelModulePromise = import('../home/infrastructure/ui/viewer/ModelViewer.js');

      videoContainer.style.display = 'block';
      video.currentTime = 3.5;
      video.play();

      await new Promise(r => setTimeout(r, 1200));

      const gap = 80;
      const topTarget = (window.innerHeight / 2) - (gap / 2);
      const bottomTarget = (window.innerHeight / 2) - (gap / 2);
      const leftTarget = (window.innerWidth / 2) - (gap / 2);
      const rightTarget = (window.innerWidth / 2) - (gap / 2);

      await Promise.all([
        animate(topPanel, { height: topTarget + 'px' }, { duration: 1.5, easing: [0.4, 0, 0.2, 1] }).finished,
        animate(bottomPanel, { height: bottomTarget + 'px' }, { duration: 1.5, easing: [0.4, 0, 0.2, 1] }).finished,
        animate(leftPanel, { width: leftTarget + 'px' }, { duration: 1.5, easing: [0.4, 0, 0.2, 1] }).finished,
        animate(rightPanel, { width: rightTarget + 'px' }, { duration: 1.5, easing: [0.4, 0, 0.2, 1] }).finished,
      ]);

      modelContainer.style.display = 'block';
      const setupPromise = (async () => {
        const { initModelViewer } = await modelModulePromise;
        const viewer = await initModelViewer(modelContainer, MODELS);
        window.__modelViewer = viewer;
        return viewer;
      })();

      await new Promise(r => setTimeout(r, 0));

      await Promise.all([
        animate(topPanel, { height: '50%' }, { duration: 0.4, easing: 'ease-in' }).finished,
        animate(bottomPanel, { height: '50%' }, { duration: 0.4, easing: 'ease-in' }).finished,
        animate(leftPanel, { width: '50%' }, { duration: 0.4, easing: 'ease-in' }).finished,
        animate(rightPanel, { width: '50%' }, { duration: 0.4, easing: 'ease-in' }).finished,
      ]);

      document.body.style.background = '#fff';
      document.documentElement.style.background = '#fff';
      videoContainer.style.display = 'none';
      topPanel.style.display = 'none';
      bottomPanel.style.display = 'none';
      leftPanel.style.display = 'none';
      rightPanel.style.display = 'none';
      window.__modelViewer = await setupPromise;
    }

    modelContainer.style.display = 'block';
    const initViewer = async () => {
      if (window.__modelViewer) return window.__modelViewer;
      const { initModelViewer } = await import('../home/infrastructure/ui/viewer/ModelViewer.js');
      const viewer = await initModelViewer(modelContainer, MODELS);
      window.__modelViewer = viewer;
      return viewer;
    };
    const viewer = await initViewer();

    const delay = window.__skipAnimation ? 200 : 2500;
    setTimeout(async () => {
      const vhsEffect = viewer.startVHS();
      await new Promise(r => setTimeout(r, 1000));
      viewer.stopVHS();
      if (viewer && viewer.dispose) viewer.dispose();
      modelContainer.style.display = 'none';

      const titleDiv = document.getElementById('portfolio-title');

      titleDiv.style.display = 'block';
      titleDiv.style.opacity = '0';
      animateTextById('title-text', 'ANDRY');
      animateTextById('title-sub', '>_AR3LYX1', 0.7, 0.15);
      animateTextById('title-text-2', 'CACERES');
      animateTextById('title-title', 'SOFTWARE DEV');
      animateTextById('title-phrase', "\"Software is like sex:", 0.28);
      animateTextById('title-phrase-2', "it's better when it's free.\"",0.28);
      animateTextById('title-autor', " - Linus Torvalds -");
      titleDiv.style.opacity = '1';

      setTimeout(() => {
        const vh = window.innerHeight * 0.01;
        document.documentElement.style.setProperty('--vh', `${vh}px`);
        window.addEventListener('resize', () => {
          const vhResize = window.innerHeight * 0.01;
          document.documentElement.style.setProperty('--vh', `${vhResize}px`);
        });
        document.body.style.overflow = 'auto';
        document.documentElement.style.overflow = 'auto';
        document.body.style.height = '';
        document.documentElement.style.height = '';
        const headContainer = document.getElementById('sitehead-container');
        headContainer.style.display = 'block';
        const workEl = document.getElementById('work-wrapper');
        if (workEl) workEl.style.display = 'block';
        const certsEl = document.getElementById('certifications-wrapper');
        if (certsEl) {
          certsEl.style.display = 'block';
          initCertMurals();
        }
        const contactEl = document.getElementById('contact-wrapper');
        if (contactEl) contactEl.style.display = 'block';
        // grid init
        const grid = document.getElementById('ws-grid');
        if (grid) {
          const items = [...grid.querySelectorAll('.ws-item')];
          const back = document.getElementById('ws-back');
          let expanded = null;
          let animating = false;

          const binaryLabels = {};
          items.forEach(i => {
            const h3 = i.querySelector('.ws-front h3');
            if (h3) binaryLabels[i.dataset.col + i.dataset.row] = h3.innerHTML;
          });

          function flipAnimate(el, toCol, toRow) {
            const first = el.getBoundingClientRect();
            el.style.gridColumn = toCol;
            el.style.gridRow = toRow;
            const last = el.getBoundingClientRect();
            const dx = first.left - last.left;
            const dy = first.top - last.top;
            const sx = first.width / last.width;
            const sy = first.height / last.height;
            return new Promise(r => {
              const anim = el.animate([
                { transform: `translate(${dx}px, ${dy}px) scaleX(${sx}) scaleY(${sy})` },
                { transform: 'translate(0,0) scaleX(1) scaleY(1)' }
              ], { duration: 600, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' });
              anim.onfinish = r;
              anim.oncancel = r;
            });
          }

          function setFrontText(item, text, animate = false) {
            const h3 = item.querySelector('.ws-front h3');
            if (!h3) return;
            const html = text.replace(/_>([: ])/g, '<br>_>$1').replace(/^<br>/, '');
            if (animate && !text.includes('<')) {
              animateDrop(h3, html);
            } else {
              h3.innerHTML = html;
            }
          }

          let linkRef = null;
          let techIntervals = [];
          let itemInterval = null;
          let carouselRef = null;

          const neuromorphicImages = [
            '/project-neuromorphic-cypher/capt1.webp',
            '/project-neuromorphic-cypher/capt2.webp',
            '/project-neuromorphic-cypher/capt3.webp',
            '/project-neuromorphic-cypher/capt4.webp',
            '/project-neuromorphic-cypher/capt5.webp',
            '/project-neuromorphic-cypher/capt6.webp',
            '/project-neuromorphic-cypher/capt7.webp',
          ];

          function initCarousel(expandEl) {
            const img = expandEl.querySelector('.ws-carousel-img');
            const viewport = expandEl.querySelector('.ws-carousel-viewport');
            const prev = expandEl.querySelector('.ws-carousel-prev');
            const next = expandEl.querySelector('.ws-carousel-next');
            if (!img || !viewport || !prev || !next) return null;

            let index = 0;
            let imageMeta = [];

            function loadImageMeta() {
              return Promise.all(neuromorphicImages.map(src => new Promise(resolve => {
                const probe = new Image();
                probe.onload = () => resolve({ src, w: probe.naturalWidth, h: probe.naturalHeight });
                probe.onerror = () => resolve({ src, w: 1, h: 1 });
                probe.src = src;
              })));
            }

            function targetLongSide() {
              const availableW = viewport.clientWidth;
              const availableH = viewport.clientHeight;
              if (!availableW || !availableH || !imageMeta.length) return 0;

              let target = Infinity;
              imageMeta.forEach(meta => {
                const maxSide = Math.max(meta.w, meta.h);
                target = Math.min(
                  target,
                  availableW * maxSide / meta.w,
                  availableH * maxSide / meta.h
                );
              });
              return target;
            }

            function fitCurrentImage() {
              const meta = imageMeta[index];
              if (!meta) return;
              const longSide = targetLongSide();
              if (!longSide) return;
              const maxSide = Math.max(meta.w, meta.h);
              const scale = longSide / maxSide;
              img.style.width = `${meta.w * scale}px`;
              img.style.height = `${meta.h * scale}px`;
            }

            function show(nextIndex) {
              index = (nextIndex + neuromorphicImages.length) % neuromorphicImages.length;
              const meta = imageMeta[index];
              if (!meta) return;
              img.src = meta.src;
              img.alt = `Neuromorphic Computing Cryptography ${index + 1}`;
              if (img.complete) fitCurrentImage();
              else img.onload = fitCurrentImage;
            }

            const onPrev = event => {
              event.stopPropagation();
              show(index - 1);
            };
            const onNext = event => {
              event.stopPropagation();
              show(index + 1);
            };
            const onResize = () => fitCurrentImage();

            prev.addEventListener('click', onPrev);
            next.addEventListener('click', onNext);
            window.addEventListener('resize', onResize);

            loadImageMeta().then(meta => {
              imageMeta = meta;
              show(0);
            });

            return {
              reset() { show(0); },
              cleanup() {
                prev.removeEventListener('click', onPrev);
                next.removeEventListener('click', onNext);
                window.removeEventListener('resize', onResize);
                img.onload = null;
                img.style.width = '';
                img.style.height = '';
              },
            };
          }

          function cleanupCarousel() {
            if (carouselRef) {
              carouselRef.cleanup();
              carouselRef = null;
            }
          }

          function renderTechColumns(cell, text) {
            const h3 = cell.querySelector('.ws-front h3');
            if (!h3) return;
            const html = text.replace(/_>([: ])/g, '<br>_>$1').replace(/^<br>/, '');
            const parts = html.split('<br>');
            const mid = 5;
            const cols = [parts.slice(0, mid), parts.slice(mid)];
            h3.innerHTML = '';
            cols.forEach(col => {
              const tc = document.createElement('div');
              tc.className = 'tc';
              col.forEach((part, pi) => {
                if (pi > 0) tc.appendChild(document.createElement('br'));
                const indent = part.startsWith('_>:');
                [...part].forEach((char, ci) => {
                  const span = document.createElement('span');
                  span.textContent = char === ' ' ? '\u00A0' : char;
                  span.style.display = 'inline-block';
                  span.style.transform = 'translateY(-103%)';
                  if (ci === 0 && indent) span.style.marginLeft = '1.8em';
                  tc.appendChild(span);
                });
              });
              h3.appendChild(tc);
            });
            const chars = [...h3.querySelectorAll('span')];
            chars.forEach((child, idx) => {
              animate(child, { transform: 'translateY(0%)' }, { duration: 0.5, delay: idx * 0.04, easing: 'linear' });
            });
          }

          function startTechSelection() {
            const techCell = items.find(i => i.dataset.col === '3' && i.dataset.row === '1');
            if (!techCell) return;
            const h3 = techCell.querySelector('.ws-front h3');
            if (!h3) return;
            techIntervals.forEach(i => clearInterval(i));
            techIntervals = [];
            const tcs = h3.querySelectorAll('.tc');
            const configs = [
              { startIdx: 0, interval: 1300 },
              { startIdx: 2, interval: 1500 }
            ];
            tcs.forEach((tc, ci) => {
              const cfg = configs[ci] || { startIdx: 0, interval: 1300 };
              const lines = [];
              let cur = [];
              for (const child of tc.childNodes) {
                if (child.tagName === 'BR') {
                  if (cur.length) { lines.push(cur); cur = []; }
                } else if (child.tagName === 'SPAN') {
                  cur.push(child);
                }
              }
              if (cur.length) lines.push(cur);
              if (lines.length < 2) return;
              let idx = cfg.startIdx % lines.length;
              lines.forEach(l => l.forEach(s => s.classList.remove('sel')));
              lines[idx].forEach(s => s.classList.add('sel'));
              const int = setInterval(() => {
                lines[idx].forEach(s => s.classList.remove('sel'));
                idx = (idx + 1) % lines.length;
                lines[idx].forEach(s => s.classList.add('sel'));
              }, cfg.interval);
              techIntervals.push(int);
            });
          }

          function startItemSelection() {
            if (itemInterval) clearInterval(itemInterval);
            items.forEach(i => i.classList.remove('hacker-sel'));
            const cycleItems = expanded ? items.filter(i => i !== expanded) : items;
            if (cycleItems.length < 2) return;
            let idx = 0;
            cycleItems[0].classList.add('hacker-sel');
            itemInterval = setInterval(() => {
              cycleItems[idx].classList.remove('hacker-sel');
              idx = (idx + 1) % cycleItems.length;
              cycleItems[idx].classList.add('hacker-sel');
            }, 1300);
          }

          function cleanupTechSelection() {
            techIntervals.forEach(i => clearInterval(i));
            techIntervals = [];
          }

          function collapse() {
            if (!expanded || animating) return;
            const el = expanded;
            expanded = null;
            const col = el.dataset.col;
            const row = el.dataset.row;
            el.classList.remove('expanding');
            if (linkRef) { linkRef.remove(); linkRef = null; }
            cleanupCarousel();
            cleanupTechSelection();
            if (itemInterval) { clearInterval(itemInterval); itemInterval = null; }
            items.forEach(i => i.classList.remove('hacker-sel'));
            const expand = el.querySelector('.ws-expand');
            const frontEl = el.querySelector('.ws-front h3');
            if (expand) expand.classList.remove('visible');
            if (back) back.classList.remove('visible');
            animating = true;
            flipAnimate(el, col, row).then(() => {
              items.forEach(i => {
                i.style.gridColumn = '';
                i.style.gridRow = '';
                const f = i.querySelector('.ws-front');
                if (f) {
                  f.classList.remove('small', 'title', 'tech');
                  f.style.opacity = '';
                }
                const key = i.dataset.col + i.dataset.row;
                if (binaryLabels[key]) {
                  const h3 = i.querySelector('.ws-front h3');
                  if (h3) h3.innerHTML = binaryLabels[key];
                }
              });
              if (frontEl) frontEl.style.opacity = '1';
              setTimeout(() => { animating = false; }, 500);
              startItemSelection();
            });
          }

          items.forEach(item => {
            item.addEventListener('click', async () => {
              if (animating) return;
              if (expanded === item) { collapse(); return; }
              if (expanded) return;

              items.forEach(i => {
                const front = i.querySelector('.ws-front');
                if (front) front.classList.remove('small', 'title', 'tech');
                const key = i.dataset.col + i.dataset.row;
                if (binaryLabels[key]) setFrontText(i, binaryLabels[key]);
              });

              const col = parseInt(item.dataset.col);
              const row = parseInt(item.dataset.row);
              const expandText = item.dataset.expand;
              const front = item.querySelector('.ws-front h3');
              const expand = item.querySelector('.ws-expand');
              if (expand && expandText && !expand.classList.contains('ws-carousel')) {
                expand.textContent = expandText;
              }

              // replace other items' front text with smaller labels
              const replaces = [item.dataset.r1, item.dataset.r2, item.dataset.r3, item.dataset.r4];
              if (replaces.some(r => r)) {
                const targets = items.filter(i => i !== item);
                targets.forEach((t, idx) => {
                  if (replaces[idx]) {
                    if (idx === 1) {
                      renderTechColumns(t, replaces[1]);
                    } else {
                      setFrontText(t, replaces[idx], true);
                    }
                    const ft = t.querySelector('.ws-front');
                    if (ft) ft.classList.add('small');
                    if (idx === 0 && ft) ft.classList.add('title');
                    if (idx === 1 && ft) ft.classList.add('tech');
                    if (idx === 2 && ft) ft.classList.add('name');
                    if (idx === 3 && ft) ft.classList.add('title-long');
                  } else {
                    const h3 = t.querySelector('.ws-front h3');
                    if (h3) h3.innerHTML = '';
                  }
                });
              }

              if (front) front.style.opacity = '0';
              if (back) back.classList.add('visible');

              const leftSide = col === 1 || (col === 2 && row === 1);
              const targetCol = leftSide ? '1 / 3' : '2 / 4';
              const targetRow = '1 / 3';

              animating = true;
              await flipAnimate(item, targetCol, targetRow);
              setTimeout(() => { animating = false; }, 500);
              item.classList.add('expanding');

              if (expand) {
                expand.classList.add('visible');
                if (expand.classList.contains('ws-carousel')) {
                  cleanupCarousel();
                  carouselRef = initCarousel(expand);
                }
              }
              expanded = item;

              setTimeout(() => startTechSelection(), 3000);
              startItemSelection();

              // add GitHub icon in bottom-right corner of expanded item
              if (item.dataset.github) {
                const ghLink = document.createElement('a');
                ghLink.href = item.dataset.github;
                ghLink.target = '_blank';
                ghLink.rel = 'noopener noreferrer';
                ghLink.innerHTML = '<svg viewBox="0 0 16 16" width="44" height="44" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>';
                ghLink.style.cssText = 'position:absolute;left:50%;bottom:1rem;transform:translateX(-50%);z-index:30;color:inherit;opacity:0.9;transition:opacity 0.2s;pointer-events:auto;';
                ghLink.addEventListener('mouseenter', () => ghLink.style.opacity = '1');
                ghLink.addEventListener('mouseleave', () => ghLink.style.opacity = '0.7');
                ghLink.addEventListener('click', event => event.stopPropagation());
                item.appendChild(ghLink);
                linkRef = ghLink;
              }
            });
          });
          if (back) {
            back.setAttribute('type', 'button');
            back.addEventListener('click', event => {
              event.stopPropagation();
              collapse();
            });
          }
          startItemSelection();
        }
        // VHS static for binary separators
        function vhsStatic(containerSelector) {
          const spans = document.querySelectorAll(`${containerSelector} span`);
          if (!spans.length) return;
          function scramble() {
            const n = 1 + Math.floor(Math.random() * 3);
            for (let i = 0; i < n; i++) {
              const idx = Math.floor(Math.random() * spans.length);
              const cur = spans[idx].textContent;
              const flip = cur === '0' ? '1' : '0';
              spans[idx].textContent = flip;
              spans[idx].style.opacity = '0.6';
              setTimeout(() => {
                spans[idx].textContent = cur;
                spans[idx].style.opacity = '1';
              }, 60 + Math.random() * 120);
            }
          }
          setInterval(scramble, 80 + Math.random() * 120);
        }
        vhsStatic('.ws-sep');
        vhsStatic('.cs-sep');
        setTimeout(() => {
          document.dispatchEvent(new CustomEvent('intro'));
        }, 300);
      }, 300);
    }, delay);
  });
</script>


