---
import type { Certification } from '../../../domain/certification';

export interface Props {
  certification: Certification;
}

const { certification } = Astro.props;
---

<div class="project-card cert-card" data-pdf={certification.link}>
  <div class="card-img">
    <img src={certification.image} alt={certification.title} loading="lazy" />
  </div>
  <div class="card-body">
    <h3>{certification.title}</h3>
    <p>{certification.description}</p>
    <div class="card-tags">
      {certification.tags.map(tag => <span>{tag}</span>)}
    </div>
    <!-- <span class="card-link">{certification.linkText}</span> -->
  </div>
</div>

<script>
  function openModal(pdfUrl: string) {
    const existing = document.getElementById('cert-modal');
    if (existing) existing.remove();

    const overlay = document.createElement('div');
    overlay.id = 'cert-modal';
    overlay.style.cssText = `
      position: fixed; inset: 0; z-index: 9999;
      background: rgba(0,0,0,0.85);
      display: flex; align-items: center; justify-content: center;
      padding: 24px;
      opacity: 0; transition: opacity 0.2s;
    `;

    const container = document.createElement('div');
    container.style.cssText = `
      position: relative; width: 90vw; height: 90vh;
      background: #1f1f1f; border-radius: 8px; overflow: hidden;
      border: 1px solid rgba(138,6,6,0.3);
      transform: scale(0.95); transition: transform 0.2s;
    `;

    const closeBtn = document.createElement('button');
    closeBtn.innerHTML = '&times;';
    closeBtn.style.cssText = `
      position: absolute; top: 12px; right: 16px; z-index: 10;
      background: none; border: none; color: #8a0606;
      font-size: 2rem; cursor: pointer; padding: 4px 10px;
      font-family: 'Ubuntu', sans-serif; line-height: 1;
      border-radius: 4px;
    `;
    closeBtn.onmouseover = () => { closeBtn.style.background = 'rgba(138,6,6,0.15)'; };
    closeBtn.onmouseout = () => { closeBtn.style.background = 'none'; };
    closeBtn.onclick = () => overlay.remove();

    const embed = document.createElement('embed');
    embed.src = pdfUrl;
    embed.type = 'application/pdf';
    embed.style.cssText = 'width:100%; height:100%; border:none; display:block;';

    container.appendChild(closeBtn);
    container.appendChild(embed);
    overlay.appendChild(container);
    document.body.appendChild(overlay);

    requestAnimationFrame(() => {
      overlay.style.opacity = '1';
      container.style.transform = 'scale(1)';
    });

    overlay.onclick = (e) => {
      if (e.target === overlay) {
        overlay.style.opacity = '0';
        container.style.transform = 'scale(0.95)';
        setTimeout(() => overlay.remove(), 200);
      }
    };
  }

  document.querySelectorAll<HTMLElement>('.cert-card').forEach(card => {
    card.addEventListener('click', () => {
      const pdfUrl = card.dataset.pdf;
      if (pdfUrl) openModal(pdfUrl);
    });
  });
</script>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    background: rgba(31, 31, 31, 0.95);
    border: 1px solid rgba(138, 6, 6, 0.25);
    border-radius: 6px;
    overflow: hidden;
    box-shadow:
      0 2px 8px rgba(0, 0, 0, 0.4),
      0 8px 32px rgba(0, 0, 0, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.03);
    cursor: pointer;
    opacity: 0.75;
    transition: opacity 0.2s;
    will-change: transform, opacity;
    text-decoration: none;
    color: inherit;
  }

  .project-card:hover {
    scale: 1.05;
    opacity: 1;
    box-shadow:
      0 4px 16px rgba(138, 6, 6, 0.2),
      0 12px 48px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    z-index: 100 !important;
  }

  .card-img {
    width: 100%;
    overflow: hidden;
    flex-shrink: 0;
  }

  .card-img img {
    width: 100%;
    height: auto;
    display: block;
  }

  .card-body {
    padding: 14px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .card-body h3 {
    font-family: 'Ubuntu', sans-serif;
    font-size: 1rem;
    color: #fafafa;
    margin: 0;
    line-height: 1.2;
  }

  .card-body p {
    font-family: 'Ubuntu', sans-serif;
    font-size: 0.72rem;
    color: rgba(250, 250, 250, 0.65);
    line-height: 1.4;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 2px;
  }

  .card-tags span {
    font-family: 'VT323', monospace;
    font-size: 0.85rem;
    padding: 2px 6px;
    border: 1px solid rgba(255, 255, 255, 0.568);
    border-radius: 3px;
    color: #b9aeae;
    letter-spacing: -0.01em;
  }

  .card-link {
    font-family: 'VT323', monospace;
    font-size: 0.7rem;
    color: #b9aeae;
    margin-top: 4px;
    text-decoration: underline;
    text-underline-offset: 2px;
    opacity: 0.8;
    transition: opacity 0.2s;
  }

  .project-card:hover .card-link {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .card-img {
      min-height: 120px;
    }

    .card-body {
      padding: 8px 10px 10px;
    }

    .card-body h3 {
      font-size: 0.85rem;
    }

    .card-body p {
      font-size: 0.65rem;
      -webkit-line-clamp: 2;
    }

    .card-tags span {
      font-size: 0.8rem;
    }
  }
</style>
