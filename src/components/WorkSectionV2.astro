  // ── Image loading helper (parallel HEAD probing) ──
  function loadProjectImages(folder) {
    const cache = loadProjectImages._cache || (loadProjectImages._cache = {});
    if (cache[folder]) return Promise.resolve(cache[folder]);

    const prefixes = ['img', 'capt'];
    const extensions = ['webp', 'png', 'jpeg', 'jpg'];

    async function probe(path) {
      try {
        const r = await fetch(path, { method: 'HEAD' });
        return r.ok;
      } catch {
        return false;
      }
    }

    return (async () => {
      // Phase 1: detect extensions for all prefixes in parallel
      const extProbes = prefixes.map(async prefix => {
        const results = await Promise.all(
          extensions.map(ext => probe(`/${folder}/${prefix}1.${ext}`))
        );
        return { prefix, ext: extensions[results.indexOf(true)] || null };
      });
      const detected = await Promise.all(extProbes);

      // Phase 2: probe all files up to 30 in parallel, apply 2-miss tolerance
      const found = [];
      await Promise.all(detected.map(async ({ prefix, ext }) => {
        if (!ext) return;
        const probes = [];
        for (let i = 1; i <= 30; i++) {
          probes.push(probe(`/${folder}/${prefix}${i}.${ext}`));
        }
        const results = await Promise.all(probes);
        let misses = 0;
        for (let i = 0; i < results.length && misses < 2; i++) {
          if (results[i]) {
            found.push(`/${folder}/${prefix}${i + 1}.${ext}`);
            misses = 0;
          } else {
            misses++;
          }
        }
      }));

      cache[folder] = found;
      return found;
    })();
  }

