</style>

<script>
  function animate(el, keyframes, options = {}) {
    const kf = Array.isArray(keyframes) ? keyframes : [{}, keyframes];
    const dur = (options.duration || 0) * 1000;
    const eas = Array.isArray(options.easing) ? `cubic-bezier(${options.easing.join(',')})` : (options.easing || 'linear');
    return el.animate(kf, { duration: dur, easing: eas, fill: 'forwards' });
  }
  const section = document.getElementById('work-v2');
  const workBlock = document.getElementById('work-wrapper');
  const rows = section?.querySelectorAll('.wv2-row') ?? [];

  if (workBlock) workBlock.style.position = 'relative';

  // ── Container (transparent bg, flex row with 3 panels) ──
  const container = document.createElement('div');
  container.className = 'wv2-container';
  workBlock?.appendChild(container);

  // Panel 1: Folders + network animation
  const panelLeft = document.createElement('div');
  panelLeft.className = 'wv2-panel left';
  container.appendChild(panelLeft);
  const canvas = document.createElement('canvas');
  panelLeft.appendChild(canvas);
  const titleLeft = document.createElement('div');
  titleLeft.className = 'wv2-titlebar';
  titleLeft.textContent = 'Explorer';
  panelLeft.appendChild(titleLeft);

  // Panel 2: Tech icons
  const panelCenter = document.createElement('div');
  panelCenter.className = 'wv2-panel center';
  container.appendChild(panelCenter);

  const canvasCenter = document.createElement('canvas');
  canvasCenter.className = 'wv2-bg-canvas';
  panelCenter.appendChild(canvasCenter);

  const techGrid = document.createElement('div');
  techGrid.className = 'wv2-tech-grid';
  panelCenter.appendChild(techGrid);

  const titleCenter = document.createElement('div');
  titleCenter.className = 'wv2-titlebar';
  titleCenter.textContent = 'System Info';
  panelCenter.appendChild(titleCenter);

  // Panel 3: README + GitHub + Web
  const panelRight = document.createElement('div');
  panelRight.className = 'wv2-panel right';
  container.appendChild(panelRight);

  const canvasRight = document.createElement('canvas');
  canvasRight.className = 'wv2-bg-canvas';
  panelRight.appendChild(canvasRight);

  const titleRight = document.createElement('div');
  titleRight.className = 'wv2-titlebar';
  titleRight.textContent = 'helpers';
  panelRight.appendChild(titleRight);

  // ── Container sizing (same as before) ──
  const BASE_RATIO = 0.85;
  const BASE_PADDING = 32;
  const WIDTH_MULT = 1.7;

  function getCanvasSize() {
    if (!workBlock) return { w: 300, h: 300 };
    const base = workBlock.offsetHeight * BASE_RATIO - BASE_PADDING;
    return { w: base * WIDTH_MULT, h: base };
  }

  function positionContainer() {
    if (!container || !workBlock) return;
    const blockRect = workBlock.getBoundingClientRect();
    const viewportCenterX = window.innerWidth / 2;
    const { w, h } = getCanvasSize();

    container.style.width = `${w}px`;
    container.style.height = `${h}px`;
    container.style.left = `${viewportCenterX - blockRect.left - w / 2}px`;
    container.style.top = `${(workBlock.offsetHeight - h) / 2 + 40}px`;
  }

  // ── Node network animation (in panelLeft) ──
  const NODE_COUNT = 80;
  const CONNECTION_DIST = 130;
  const NODE_SPEED = 0.4;
  let nodes = [];
  let animId = null;

  function initNodes(w, h) {
    nodes = [];
    for (let i = 0; i < NODE_COUNT; i++) {
      nodes.push({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * NODE_SPEED,
        vy: (Math.random() - 0.5) * NODE_SPEED,
      });
    }
  }

  function drawNetwork() {
    if (!canvas) return;
    const rect = canvas.getBoundingClientRect();
    if (rect.width <= 0 || rect.height <= 0) return;
    const dpr = window.devicePixelRatio || 1;
    if (canvas.width !== Math.round(rect.width * dpr) || canvas.height !== Math.round(rect.height * dpr)) {
      canvas.width = Math.round(rect.width * dpr);
      canvas.height = Math.round(rect.height * dpr);
    }
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    ctx.fillStyle = '#332828';
    ctx.fillRect(0, 0, rect.width, rect.height);

    for (const n of nodes) {
      n.x += n.vx;
      n.y += n.vy;
      if (n.x < 0 || n.x > rect.width) n.vx *= -1;
      if (n.y < 0 || n.y > rect.height) n.vy *= -1;
    }

    ctx.strokeStyle = '#e6e6e6';
    ctx.lineWidth = 0.6;
    for (let i = 0; i < nodes.length; i++) {
      for (let j = i + 1; j < nodes.length; j++) {
        const dx = nodes[i].x - nodes[j].x;
        const dy = nodes[i].y - nodes[j].y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < CONNECTION_DIST) {
          const alpha = 1 - dist / CONNECTION_DIST;
          ctx.globalAlpha = alpha * 0.5;
          ctx.beginPath();
          ctx.moveTo(nodes[i].x, nodes[i].y);
          ctx.lineTo(nodes[j].x, nodes[j].y);
          ctx.stroke();
        }
      }
    }

    ctx.globalAlpha = 0.8;
    ctx.fillStyle = '#e6e6e6';
    for (const n of nodes) {
      ctx.beginPath();
      ctx.arc(n.x, n.y, 2, 0, Math.PI * 2);
      ctx.fill();
    }

    ctx.globalAlpha = 1;
    animId = requestAnimationFrame(drawNetwork);
  }

  // ── Evangelion geometric figures (panelCenter) ──
  let rippleId = null;
  let rippleTime = 0;
  let ripples = [];

  function spawnRipple(w, h) {
    ripples.push({
      x: Math.random() * w,
      y: Math.random() * h,
      r: 0,
      maxR: 20 + Math.random() * 120,
      speed: 0.3 + Math.random() * 1.2,
      alpha: 0.5 + Math.random() * 0.5,
      hue: 180 + Math.random() * 120,
      shape: Math.floor(Math.random() * 4),
      sides: Math.floor(Math.random() * 3) + 3,
      rotation: Math.random() * Math.PI * 2,
    });
  }

  function drawShape(ctx, x, y, r, sides, rot) {
    if (sides === 0) {
      ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); return;
    }
    ctx.beginPath();
    for (let i = 0; i <= sides; i++) {
      const a = rot + (i / sides) * Math.PI * 2;
      const px = x + Math.cos(a) * r, py = y + Math.sin(a) * r;
      i === 0 ? ctx.moveTo(px, py) : ctx.lineTo(px, py);
    }
    ctx.closePath();
  }

  function drawRipples() {
    if (!canvasCenter) return;
    const rect = canvasCenter.getBoundingClientRect();
    if (rect.width <= 0 || rect.height <= 0) { rippleId = requestAnimationFrame(drawRipples); return; }
    const dpr = window.devicePixelRatio || 1;
    if (canvasCenter.width !== Math.round(rect.width * dpr) || canvasCenter.height !== Math.round(rect.height * dpr)) {
      canvasCenter.width = Math.round(rect.width * dpr);
      canvasCenter.height = Math.round(rect.height * dpr);
    }
    const ctx = canvasCenter.getContext('2d');
    if (!ctx) return;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, rect.width, rect.height);

    rippleTime += 0.016;

    if (rippleTime % 0.3 < 0.016 && ripples.length < 80) spawnRipple(rect.width, rect.height);

    for (let i = ripples.length - 1; i >= 0; i--) {
      const o = ripples[i];
      o.r += o.speed;
      o.rotation += 0.01;
      const progress = o.r / o.maxR;
      const alpha = o.alpha * (1 - progress);

      if (alpha <= 0 || o.r > o.maxR) { ripples.splice(i, 1); continue; }

      const fillA = alpha * 0.15;
      ctx.fillStyle = `hsla(${o.hue}, 65%, 55%, ${fillA})`;
      ctx.strokeStyle = `hsla(${o.hue}, 70%, 50%, ${alpha * 0.9})`;
      ctx.lineWidth = 1.5 + (1 - progress) * 2;
      drawShape(ctx, o.x, o.y, o.r, o.shape === 0 ? 0 : o.sides, o.rotation);
      ctx.fill();
      ctx.stroke();

      if (o.r > 15) {
        const innerR = o.r * (0.4 + 0.2 * Math.sin(o.rotation));
        ctx.fillStyle = `hsla(${o.hue + 40}, 60%, 60%, ${fillA * 0.6})`;
        ctx.strokeStyle = `hsla(${o.hue + 40}, 65%, 55%, ${alpha * 0.5})`;
        ctx.lineWidth = 1;
        drawShape(ctx, o.x, o.y, innerR, o.shape === 0 ? 0 : o.sides, o.rotation + 0.5);
        ctx.fill();
        ctx.stroke();
      }
    }

    rippleId = requestAnimationFrame(drawRipples);
  }

  // ── Koch curve animation (panelRight) ──
  let kochId = null;
  let kochTime = 0;

  function kochSegment(ctx, x1, y1, x2, y2, iter) {
    if (iter <= 0) {
      ctx.lineTo(x2, y2);
      return;
    }
    const dx = x2 - x1;
    const dy = y2 - y1;
    const thirdX = x1 + dx / 3;
    const thirdY = y1 + dy / 3;
    const twoThirdX = x1 + (2 * dx) / 3;
    const twoThirdY = y1 + (2 * dy) / 3;

    const angle = Math.atan2(dy, dx) + Math.PI / 3 * Math.sin(kochTime + iter * 0.5);
    const len = Math.sqrt(dx * dx + dy * dy) / 3;
    const peakX = thirdX + Math.cos(angle) * len;
    const peakY = thirdY + Math.sin(angle) * len;

    kochSegment(ctx, x1, y1, thirdX, thirdY, iter - 1);
    kochSegment(ctx, thirdX, thirdY, peakX, peakY, iter - 1);
    kochSegment(ctx, peakX, peakY, twoThirdX, twoThirdY, iter - 1);
    kochSegment(ctx, twoThirdX, twoThirdY, x2, y2, iter - 1);
  }

  function drawKochCurve() {
    if (!canvasRight) return;
    const rect = canvasRight.getBoundingClientRect();
    if (rect.width <= 0 || rect.height <= 0) { kochId = requestAnimationFrame(drawKochCurve); return; }
    const dpr = window.devicePixelRatio || 1;
    if (canvasRight.width !== Math.round(rect.width * dpr) || canvasRight.height !== Math.round(rect.height * dpr)) {
      canvasRight.width = Math.round(rect.width * dpr);
      canvasRight.height = Math.round(rect.height * dpr);
    }
    const ctx = canvasRight.getContext('2d');
    if (!ctx) return;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    ctx.fillStyle = '#1a0a2e';
    ctx.fillRect(0, 0, rect.width, rect.height);

    kochTime += 0.01;

    const size = Math.min(rect.width, rect.height) * 0.35;
    const cx = rect.width / 2;
    const cy = rect.height / 2;
    const iter = 3;

    ctx.strokeStyle = `hsl(${280 + Math.sin(kochTime) * 20}, 70%, 60%)`;
    ctx.lineWidth = 1.2;
    ctx.beginPath();
    const spread = Math.PI * 2 / 3;
    for (let i = 0; i < 3; i++) {
      const a1 = i * spread - Math.PI / 2 + Math.sin(kochTime * 0.3) * 0.1;
      const a2 = ((i + 1) % 3) * spread - Math.PI / 2 + Math.sin(kochTime * 0.3) * 0.1;
      const x1 = cx + Math.cos(a1) * size;
      const y1 = cy + Math.sin(a1) * size;
      const x2 = cx + Math.cos(a2) * size;
      const y2 = cy + Math.sin(a2) * size;
      ctx.moveTo(x1, y1);
      kochSegment(ctx, x1, y1, x2, y2, iter);
    }
    ctx.closePath();
    ctx.stroke();

    ctx.fillStyle = `hsla(${280 + Math.sin(kochTime) * 20}, 60%, 50%, 0.08)`;
    ctx.fill();

    kochId = requestAnimationFrame(drawKochCurve);
  }

  function startAnimation() {
    if (!canvas) return;
    const rect = canvas.getBoundingClientRect();
    if (rect.width > 0 && rect.height > 0) {
      initNodes(rect.width, rect.height);
    } else {
      initNodes(300, 300);
    }
    if (animId) cancelAnimationFrame(animId);
    drawNetwork();

    if (canvasCenter) {
      rippleTime = 0;
      if (rippleId) cancelAnimationFrame(rippleId);
      drawRipples();
    }

    if (canvasRight) {
      kochTime = 0;
      if (kochId) cancelAnimationFrame(kochId);
      drawKochCurve();
    }
  }

  function stopAnimation() {
    if (animId) {
      cancelAnimationFrame(animId);
      animId = null;
    }
    if (rippleId) {
      cancelAnimationFrame(rippleId);
      rippleId = null;
    }
    if (kochId) {
      cancelAnimationFrame(kochId);
      kochId = null;
    }
  }

