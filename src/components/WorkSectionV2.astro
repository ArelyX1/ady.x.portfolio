          requestAnimationFrame(updatePanels);
          showFolders();
        }
      } else {
        currentProject = '';
        if (container) {
          container.classList.remove('open');
          stopAnimation();
          hideFolders();
          if (postitEl) postitEl.classList.remove('open');
          closeCarousel();
        }
      }
    });
  });

  window.addEventListener('resize', () => {
    if (container?.classList.contains('open')) {
      positionContainer();
      updatePanels();
    }
  });

  createFolderComponents();
  createRightPanelIcons();
  postitEl = createPostit();
</script>
