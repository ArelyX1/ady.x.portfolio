<style>
  .wv2 {
    font-family: 'Ubuntu', monospace;
    padding: 3rem 0;
    position: relative;
  }
  .wv2-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 0;
    transition: background 0.2s ease, box-shadow 0.2s ease;
    border-radius: 4px;
    cursor: pointer;
    position: relative;
    z-index: 2;
  }
  .wv2-row:hover,
  .wv2-row.selected {
    background: rgba(0, 0, 0, 0.03);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
  }
  .wv2-item {
    padding: 1rem 0;
    font-size: clamp(0.6rem, 1.1vw, 0.75rem);
    font-weight: 500;
    letter-spacing: 0.04em;
    user-select: none;
    pointer-events: none;
    white-space: nowrap;
  }
  .wv2-item.left {
    padding-left: 2vw;
    text-align: left;
    color: #1f1f1f;
  }
  .wv2-item.right {
    padding-right: 2vw;
    text-align: right;
    color: #666;
  }
  :global(.wv2-container) {
    position: absolute;
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
    z-index: 10;
    border-radius: 4px;
    overflow: hidden;
  }
  :global(.wv2-container.open) {
    opacity: 1;
    pointer-events: auto;
  }
  :global(.wv2-container canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }
  :global(.wv2-folder-wrap) {
    position: absolute;
    z-index: 11;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    cursor: grab;
    pointer-events: none;
    user-select: none;
    touch-action: none;
  }
  :global(.wv2-container.open .wv2-folder-wrap) {
    pointer-events: auto;
  }
  :global(.wv2-folder-wrap:active) {
    cursor: grabbing;
  }
  :global(.wv2-folder) {
    width: 144px;
    height: 144px;
  }
  :global(.wv2-folder img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    -webkit-user-drag: none;
    user-select: none;
  }
  :global(.wv2-flabel) {
    font-family: 'VT323', monospace;
    font-size: 16px;
    color: #fff;
    text-align: center;
    width: 160px;
    pointer-events: none;
    user-select: none;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  :global(.wv2-folder-wrap.open .wv2-flabel) {
    opacity: 1;
  }
  @keyframes win-open {
    0% { scale: 0; opacity: 0; }
    100% { scale: 1; opacity: 1; }
  }

  :global(.wv2-carousel) {
    position: fixed;
    z-index: 100;
    background: #c0c0c0;
    box-shadow: 8px 8px 0 rgba(0,0,0,0.3);
    display: none;
    font-family: 'VT323', monospace;
    width: auto;
    border: 3px solid #000;
  }
  :global(.wv2-carousel.open) {
    display: block;
  }
  :global(.wv2-carousel-titlebar) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 14px;
    cursor: move;
    border-bottom: 3px solid #000;
    color: #000;
    font-size: 18px;
    user-select: none;
  }
  :global(.wv2-carousel-close) {
    background: none;
    border: 2px solid #000;
    color: #000;
    cursor: pointer;
    font-size: 20px;
    line-height: 1;
    padding: 2px 10px;
    font-family: inherit;
  }
  :global(.wv2-carousel-body) {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  :global(.wv2-carousel-body img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    background: #1a1a1a;
  }
  :global(.wv2-carousel-btn) {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: 3px solid #fff;
    color: #fff;
    font-size: 28px;
    cursor: pointer;
    padding: 8px 16px;
    font-family: inherit;
    line-height: 1;
  }
  :global(.wv2-carousel-btn:hover) {
    background: rgba(255,255,255,0.1);
  }
  :global(.wv2-carousel-prev) {
    left: 4px;
  }
  :global(.wv2-carousel-next) {
    right: 4px;
  }
</style>

<script>
  import { hover, press, animate } from 'motion';

  const section = document.getElementById('work-v2');
  const workBlock = document.getElementById('work-wrapper');
  const rows = section?.querySelectorAll('.wv2-row') ?? [];

  if (workBlock) workBlock.style.position = 'relative';

  // ── Container que envuelve canvas + folders ──
  const container = document.createElement('div');
  container.className = 'wv2-container';
  workBlock?.appendChild(container);

  const canvas = document.createElement('canvas');
  container.appendChild(canvas);

  // ── Rectangular canvas (wider than tall) ──
  const BASE_RATIO = 0.85;
  const BASE_PADDING = 32;
  const WIDTH_MULT = 1.7;

  function getCanvasSize() {
    if (!workBlock) return { w: 300, h: 300 };
    const base = workBlock.offsetHeight * BASE_RATIO - BASE_PADDING;
    return { w: base * WIDTH_MULT, h: base };
  }

  function positionCanvas() {
    if (!container || !workBlock) return;
    const blockRect = workBlock.getBoundingClientRect();
    const viewportCenterX = window.innerWidth / 2;
    const { w, h } = getCanvasSize();

    container.style.width = `${w}px`;
    container.style.height = `${h}px`;
    container.style.left = `${viewportCenterX - blockRect.left - w / 2}px`;
    container.style.top = `${(workBlock.offsetHeight - h) / 2 + 40}px`;
  }

  // ── Node network animation ──
  const NODE_COUNT = 80;
  const CONNECTION_DIST = 130;
  const NODE_SPEED = 0.4;
  let nodes = [];
  let animId = null;

  function initNodes(w, h) {
    nodes = [];
    for (let i = 0; i < NODE_COUNT; i++) {
      nodes.push({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * NODE_SPEED,
        vy: (Math.random() - 0.5) * NODE_SPEED,
      });
    }
  }

  function drawNetwork() {
    if (!canvas) return;
    const rect = canvas.getBoundingClientRect();
    if (rect.width <= 0 || rect.height <= 0) return;
    const dpr = window.devicePixelRatio || 1;
    if (canvas.width !== Math.round(rect.width * dpr) || canvas.height !== Math.round(rect.height * dpr)) {
      canvas.width = Math.round(rect.width * dpr);
      canvas.height = Math.round(rect.height * dpr);
    }
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    // Background
    ctx.fillStyle = '#332828';
    ctx.fillRect(0, 0, rect.width, rect.height);

    // Update nodes
    for (const n of nodes) {
      n.x += n.vx;
      n.y += n.vy;
      if (n.x < 0 || n.x > rect.width) n.vx *= -1;
      if (n.y < 0 || n.y > rect.height) n.vy *= -1;
    }

    // Draw connections
    ctx.strokeStyle = '#e6e6e6';
    ctx.lineWidth = 0.6;
    for (let i = 0; i < nodes.length; i++) {
      for (let j = i + 1; j < nodes.length; j++) {
        const dx = nodes[i].x - nodes[j].x;
        const dy = nodes[i].y - nodes[j].y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < CONNECTION_DIST) {
          const alpha = 1 - dist / CONNECTION_DIST;
          ctx.globalAlpha = alpha * 0.5;
          ctx.beginPath();
          ctx.moveTo(nodes[i].x, nodes[i].y);
          ctx.lineTo(nodes[j].x, nodes[j].y);
          ctx.stroke();
        }
      }
    }

    // Draw nodes
    ctx.globalAlpha = 0.8;
    ctx.fillStyle = '#e6e6e6';
    for (const n of nodes) {
      ctx.beginPath();
      ctx.arc(n.x, n.y, 2, 0, Math.PI * 2);
      ctx.fill();
    }

    ctx.globalAlpha = 1;
    animId = requestAnimationFrame(drawNetwork);
  }

  function startAnimation() {
    if (!canvas) return;
    const rect = canvas.getBoundingClientRect();
    if (rect.width > 0 && rect.height > 0) {
      initNodes(rect.width, rect.height);
    } else {
      initNodes(300, 300);
    }
    if (animId) cancelAnimationFrame(animId);
    drawNetwork();
  }

  function stopAnimation() {
    if (animId) {
      cancelAnimationFrame(animId);
      animId = null;
    }
  }

  // ── Folder components (wrap = icon + label in one container) ──
  const folderData = [
    { name: 'git', src: '/folderGit.png', label: 'Description' },
    { name: 'img', src: '/folderImg.png', label: 'Frontend' },
    { name: 'back', src: '/folderBack.png', label: 'Backend' },
  ];

  const folderWraps = [];

  function createFolderComponents() {
    if (!container) return;
    folderData.forEach((f) => {
      const wrap = document.createElement('div');
      wrap.className = 'wv2-folder-wrap';
      wrap.dataset.folder = f.name;

      const el = document.createElement('div');
      el.className = 'wv2-folder';
      const img = document.createElement('img');
      img.src = f.src; img.alt = f.name; img.draggable = false;
      el.appendChild(img);
      wrap.appendChild(el);

      const lbl = document.createElement('div');
      lbl.className = 'wv2-flabel';
      lbl.textContent = f.label;
      wrap.appendChild(lbl);

      container.appendChild(wrap);
      folderWraps.push(wrap);

      // Hover gesture (Motion)
      hover(wrap, {
        onHoverStart: () => { animate(wrap, { scale: 1.15 }, { duration: 0.2, easing: 'ease-out' }); },
        onHoverEnd: () => { animate(wrap, { scale: 1 }, { duration: 0.2, easing: 'ease-out' }); },
      });

      // Press gesture (Motion)
      press(wrap, {
        onPressStart: () => { animate(wrap, { scale: 0.9 }, { duration: 0.1, easing: 'ease-out' }); },
        onPressEnd: () => { animate(wrap, { scale: 1 }, { duration: 0.15, easing: 'ease-out' }); },
      });

      // Drag with pointer events (clamped inside container)
      let dragging = false, startX, startY, origX, origY;
      const ww = 144, wh = 144 + 30;

      wrap.addEventListener('pointerdown', (e) => {
        dragging = true;
        wrap.setPointerCapture(e.pointerId);
        startX = e.clientX; startY = e.clientY;
        origX = parseFloat(wrap.style.left) || 0;
        origY = parseFloat(wrap.style.top) || 0;
      });

      wrap.addEventListener('pointermove', (e) => {
        if (!dragging || !container) return;
        const cr = container.getBoundingClientRect();
        const nl = Math.max(0, Math.min(cr.width - ww, origX + e.clientX - startX));
        const nt = Math.max(0, Math.min(cr.height - wh, origY + e.clientY - startY));
        wrap.style.left = `${nl}px`;
        wrap.style.top = `${nt}px`;
      });

      wrap.addEventListener('pointerup', () => { dragging = false; });
      wrap.addEventListener('pointercancel', () => { dragging = false; });

      // Click handler
      wrap.addEventListener('click', (e) => {
        e.stopPropagation();
        if (!currentProject) return;
        if (f.name === 'img') loadProjectImages(currentProject).then(imgs => { if (imgs.length) showCarousel(imgs, `/${currentProject}`); });
        if (f.name === 'back') loadProjectImages(`${currentProject}/back`).then(imgs => { if (imgs.length) showCarousel(imgs, `/${currentProject}/back`); });
      });
    });
  }

  function positionFolders(cw, ch) {
    const ww = 144, gap = 16, wh = 144 + 30;
    const positions = [
      { left: gap, top: ch - wh - gap },
      { left: cw / 2 - ww / 2, top: ch - wh - gap },
      { left: cw - ww - gap, top: ch - wh - gap },
    ];
    folderWraps.forEach((wrap, i) => {
      wrap.style.left = `${positions[i].left}px`;
      wrap.style.top = `${positions[i].top}px`;
    });
  }

  function showFolders() {
    folderWraps.forEach(wrap => wrap.classList.add('open'));
  }

  function hideFolders() {
    folderWraps.forEach(wrap => {
      wrap.classList.remove('open');
      wrap.style.left = '';
      wrap.style.top = '';
    });
  }

  // ── Carousel window ──
  let currentProject = '';
  let carouselImages = [];
  let carouselIndex = 0;

  const carousel = document.createElement('div');
  carousel.className = 'wv2-carousel';
  const titlebar = document.createElement('div');
  titlebar.className = 'wv2-carousel-titlebar';
  const titleSpan = document.createElement('span');
  titleSpan.textContent = 'images';
  const closeBtn = document.createElement('button');
  closeBtn.className = 'wv2-carousel-close';
  closeBtn.textContent = '×';
  titlebar.appendChild(titleSpan);
  titlebar.appendChild(closeBtn);
  const body = document.createElement('div');
  body.className = 'wv2-carousel-body';
  const carouselImg = document.createElement('img');
  const prevBtn = document.createElement('button');
  prevBtn.className = 'wv2-carousel-btn wv2-carousel-prev';
  prevBtn.textContent = '◀';
  const nextBtn = document.createElement('button');
  nextBtn.className = 'wv2-carousel-btn wv2-carousel-next';
  nextBtn.textContent = '▶';
  body.appendChild(prevBtn);
  body.appendChild(carouselImg);
  body.appendChild(nextBtn);
  carousel.appendChild(titlebar);
  carousel.appendChild(body);
  document.body.appendChild(carousel);

  function resizeCarouselToImage(src, callback) {
    const tmp = new Image();
    tmp.onload = () => {
      const maxW = Math.min(1100, window.innerWidth * 0.9);
      const maxH = Math.min(750, window.innerHeight * 0.75);
      const natW = tmp.naturalWidth;
      const natH = tmp.naturalHeight;
      const imgRatio = natW / natH;
      const maxRatio = maxW / maxH;
      let dispW, dispH;
      if (imgRatio > maxRatio) {
        dispW = maxW;
        dispH = Math.round(maxW / imgRatio);
      } else {
        dispH = maxH;
        dispW = Math.round(maxH * imgRatio);
      }
      body.style.width = `${Math.max(280, dispW)}px`;
      body.style.height = `${Math.max(180, dispH)}px`;
      if (callback) callback();
    };
    tmp.onerror = () => {
      body.style.width = '800px';
      body.style.height = '560px';
      if (callback) callback();
    };
    tmp.src = src;
  }

  function showCarousel(images, title) {
    if (images.length === 0) return;
    carouselImages = images;
    carouselIndex = 0;
    titleSpan.textContent = title;

    // Random position near center of work-wrapper
    const wb = workBlock?.getBoundingClientRect();
    if (wb) {
      const cx = wb.left + wb.width / 2;
      const cy = wb.top + wb.height / 2;
      carousel.style.left = `${cx - 160 + (Math.random() - 0.5) * 120}px`;
      carousel.style.top = `${cy - 120 + (Math.random() - 0.5) * 80}px`;
    } else {
      carousel.style.left = `${120 + (Math.random() - 0.5) * 120}px`;
      carousel.style.top = `${120 + (Math.random() - 0.5) * 80}px`;
    }

    resizeCarouselToImage(images[0], () => {
      carouselImg.src = images[0];
      carousel.classList.add('open');
      carousel.style.animation = 'none';
      void carousel.offsetHeight;
      carousel.style.animation = 'win-open 0.3s cubic-bezier(.34,1.56,.64,1) forwards';
    });
  }

  function closeCarousel() {
    carousel.classList.remove('open');
    carousel.style.animation = '';
    carouselImages = [];
  }

  closeBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    closeCarousel();
  });

  function goToImage(index) {
    if (carouselImages.length === 0) return;
    const src = carouselImages[index];
    resizeCarouselToImage(src, () => {
      carouselImg.src = src;
    });
  }

  prevBtn.addEventListener('click', () => {
    if (carouselImages.length === 0) return;
    carouselIndex = (carouselIndex - 1 + carouselImages.length) % carouselImages.length;
    goToImage(carouselIndex);
  });

  nextBtn.addEventListener('click', () => {
    if (carouselImages.length === 0) return;
    carouselIndex = (carouselIndex + 1) % carouselImages.length;
    goToImage(carouselIndex);
  });

  // Drag carousel by titlebar only
  let carDrag = false;
  let carStartX, carStartY, carOrigX, carOrigY;

  titlebar.addEventListener('pointerdown', (e) => {
    if (e.target.closest('.wv2-carousel-close')) return;
    carDrag = true;
    titlebar.setPointerCapture(e.pointerId);
    carStartX = e.clientX;
    carStartY = e.clientY;
    carOrigX = parseInt(carousel.style.left) || 0;
    carOrigY = parseInt(carousel.style.top) || 0;
  });

  titlebar.addEventListener('pointermove', (e) => {
    if (!carDrag) return;
    carousel.style.left = `${carOrigX + e.clientX - carStartX}px`;
    carousel.style.top = `${carOrigY + e.clientY - carStartY}px`;
  });

  titlebar.addEventListener('pointerup', () => { carDrag = false; });
  titlebar.addEventListener('pointercancel', () => { carDrag = false; });

  // ── Image loading helper ──
  function loadProjectImages(folder) {
    const prefixes = ['img', 'capt'];

    function probe(path) {
      return new Promise((resolve) => {
        const img = new Image();
        img.onload = () => resolve(true);
        img.onerror = () => resolve(false);
        img.src = path;
      });
    }

    async function detectExt(prefix) {
      for (const ext of ['png', 'jpeg', 'jpg']) {
        if (await probe(`/${folder}/${prefix}1.${ext}`)) return ext;
      }
      return null;
    }

    return (async () => {
      const found = [];
      for (const prefix of prefixes) {
        const ext = await detectExt(prefix);
        if (!ext) continue;
        let misses = 0;
        for (let i = 1; i <= 30 && misses < 2; i++) {
          const path = `/${folder}/${prefix}${i}.${ext}`;
          if (await probe(path)) {
            found.push(path);
            misses = 0;
          } else {
            misses++;
          }
        }
      }
      return found;
    })();
  }

  // ── Fill & update ──
  function updateCanvas() {
    if (!container?.classList.contains('open')) return;
    positionCanvas();
    const rect = container.getBoundingClientRect();
    initNodes(rect.width, rect.height);
    positionFolders(rect.width, rect.height);
    if (animId) cancelAnimationFrame(animId);
    drawNetwork();
  }

  container?.addEventListener('click', (e) => e.stopPropagation());

  container?.addEventListener('transitionend', (e) => {
    if (e.propertyName === 'opacity' && container.classList.contains('open')) {
      updateCanvas();
    }
  });

  rows.forEach(row => {
    row.addEventListener('click', () => {
      const wasSelected = row.classList.contains('selected');
      rows.forEach(r => r.classList.remove('selected'));
      if (!wasSelected) {
        row.classList.add('selected');
        currentProject = row.dataset.project || '';
        const hasBack = row.dataset.hasback === 'true';
        if (folderWraps[2]) folderWraps[2].style.display = hasBack ? '' : 'none';
        if (container) {
          positionCanvas();
          container.classList.add('open');
          requestAnimationFrame(updateCanvas);
          showFolders();
        }
      } else {
        currentProject = '';
        if (container) {
          container.classList.remove('open');
          stopAnimation();
          hideFolders();
        }
      }
    });
  });

  window.addEventListener('resize', () => {
    if (container?.classList.contains('open')) updateCanvas();
  });

  createFolderComponents();
</script>
