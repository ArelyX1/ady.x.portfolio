  }
  .wv2-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 0;
    transition: background 0.2s ease, box-shadow 0.2s ease;
    border-radius: 4px;
    cursor: pointer;
    position: relative;
    z-index: 2;
