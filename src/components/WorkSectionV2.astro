  }

  :global(.wv2-panel)::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 15;
    pointer-events: none;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 1px,
      rgba(0,0,0,0.15) 1px,
      rgba(0,0,0,0.15) 2px
