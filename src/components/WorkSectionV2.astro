  :global(.wv2-panel) {
    height: 100%;
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
    border: 2px solid #000;
    box-shadow:
      inset 1px 1px 0 #dfdfdf,
      inset -1px -1px 0 #808080;
