  :global(.wv2-panel.left > *:not(canvas):not(.wv2-bg-canvas):not(.wv2-titlebar):not(.wv2-folder-wrap)),
  :global(.wv2-panel.center > *:not(canvas):not(.wv2-bg-canvas):not(.wv2-titlebar)),
  :global(.wv2-panel.right > *:not(canvas):not(.wv2-bg-canvas):not(.wv2-titlebar)) {
