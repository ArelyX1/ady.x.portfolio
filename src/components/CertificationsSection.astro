---
import CertCard from '../certifications/infrastructure/ui/components/CertCard.astro';
import { getCertificationsByCategory } from '../certifications/application/certifications';

const techCerts = getCertificationsByCategory('technical');
const otrosCerts = getCertificationsByCategory('otros');
---

<div id="certifications">
  <div class="certs-label">&gt; CERTIFICATES</div>
  <section class="crt-mural" id="crt-tech">
    <div class="crt-sticky">
      <div class="crt-track" id="crt-track-tech">
        <div class="crt-wall" id="crt-wall-tech">
          <h2 class="crt-title" id="crt-title-tech">TECHNICAL</h2>
          {techCerts.map(cert => <CertCard certification={cert} />)}
        </div>
      </div>
    </div>
  </section>
  <section class="crt-mural" id="crt-otros">
    <div class="crt-sticky">
      <div class="crt-track" id="crt-track-otros">
        <div class="crt-wall" id="crt-wall-otros">
          <h2 class="crt-title" id="crt-title-otros">PARTICIPATION<br>& OTHERS</h2>
          {otrosCerts.map(cert => <CertCard certification={cert} />)}
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  #certifications {
    width: 100%;
  }
  .certs-label {
    text-align: center;
    font-size: clamp(1rem, 2.5vw, 1.8rem);
    font-weight: 700;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: #444;
    padding: 2rem 0 1rem;
    font-family: 'VT323', 'Courier New', monospace;
  }
  .crt-mural {
    position: relative;
    height: 300vh;
  }
  .crt-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    background: transparent;
  }
  .crt-track {
    height: 100%;
  }
  .crt-wall {
    position: relative;
  }
  .crt-title {
    position: absolute;
    font-family: 'Ubuntu', monospace;
    font-size: clamp(2.5rem, 5vw, 5rem);
    color: #8a0606;
    letter-spacing: 0.05em;
    z-index: 50;
    pointer-events: none;
    margin: 0;
    white-space: nowrap;
    text-shadow: 0 0 20px rgba(138, 6, 6, 0.3), 0 0 60px rgba(138, 6, 6, 0.1);
  }

  @media (max-width: 767px) {
    .crt-mural, .crt-mural.crt-nojs {
      height: auto;
    }
    .crt-sticky {
      position: relative;
      height: auto;
      overflow: visible;
    }
    .crt-track {
      height: auto;
      transform: none !important;
    }
    .crt-wall {
      width: 100% !important;
      height: auto !important;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      padding: 0 5% 100px;
    }
    .crt-title {
      position: relative;
      top: auto !important;
      left: auto !important;
      transform: none !important;
      white-space: normal;
      text-align: center;
      padding: 2rem 1rem 1rem;
      font-size: clamp(1.5rem, 3vw, 2.5rem);
    }
    .project-card {
      position: relative !important;
      width: 100% !important;
      height: auto !important;
      left: auto !important;
      top: auto !important;
      transform: none !important;
      rotate: none !important;
      z-index: auto !important;
    }
  }
  @media (max-width: 550px) {
    .crt-wall {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      padding: 0 4% 80px;
    }
    .crt-title {
      font-size: clamp(1.2rem, 3.5vw, 1.8rem);
      padding: 1.5rem 0.5rem 0.8rem;
    }
  }
  @media (max-width: 400px) {
    .crt-wall {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 0 5% 80px;
    }
  }

  .crt-mural.crt-nojs {
    height: auto;
  }
  .crt-mural.crt-nojs .crt-sticky {
    position: relative;
    height: auto;
    overflow: visible;
  }
  .crt-mural.crt-nojs .crt-track {
    height: auto;
    transform: none;
  }
  .crt-mural.crt-nojs .crt-wall {
    width: 100%;
    height: auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    padding: 0 5% 100px;
  }
  .crt-mural.crt-nojs .crt-title {
    position: relative;
    top: auto;
    left: auto;
    transform: none;
    white-space: normal;
    text-align: center;
    padding: 2rem 1rem 1rem;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
  }
  .crt-mural.crt-nojs .project-card {
    position: relative;
    width: 100%;
    height: auto;
    left: auto;
    top: auto;
    transform: none;
    rotate: none;
    z-index: auto;
  }
  @media (max-width: 767px) {
    .crt-mural.crt-nojs .crt-wall {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 400px) {
    .crt-mural.crt-nojs .crt-wall {
      grid-template-columns: 1fr;
    }
  }
</style>
