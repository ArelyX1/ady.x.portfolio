---
import CertCard from '../certifications/infrastructure/ui/components/CertCard.astro';
import { getCertificationsByCategory } from '../certifications/application/certifications';

const techCerts = getCertificationsByCategory('technical');
const leadCerts = getCertificationsByCategory('leadership');
---

<div id="crt-wrap">
  <section class="crt-mural" id="crt-tech">
    <div class="crt-sticky">
      <div class="crt-track" id="crt-track-tech">
        <div class="crt-wall" id="crt-wall-tech">
          <h2 class="crt-title" id="crt-title-tech">TECHNICAL</h2>
          {techCerts.map(cert => <CertCard certification={cert} />)}
        </div>
      </div>
    </div>
  </section>
  <section class="crt-mural" id="crt-lead">
    <div class="crt-sticky">
      <div class="crt-track" id="crt-track-lead">
        <div class="crt-wall" id="crt-wall-lead">
          <h2 class="crt-title" id="crt-title-lead">LEADERSHIP</h2>
          {leadCerts.map(cert => <CertCard certification={cert} />)}
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  #crt-wrap {
    width: 100%;
  }
  .crt-mural {
    position: relative;
    height: 300vh;
  }
  .crt-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    background: transparent;
  }
  .crt-track {
    height: 100%;
  }
  .crt-wall {
    position: relative;
  }
  .crt-title {
    position: absolute;
    font-family: 'Ubuntu', monospace;
    font-size: clamp(2.5rem, 5vw, 5rem);
    color: #8a0606;
    letter-spacing: 0.05em;
    z-index: 50;
    pointer-events: none;
    margin: 0;
    white-space: nowrap;
    text-shadow: 0 0 20px rgba(138, 6, 6, 0.3), 0 0 60px rgba(138, 6, 6, 0.1);
  }
</style>

<script>
  import { scroll } from 'motion';

  let initialized = false;

  function initOne(id, trackId, wallId, titleId) {
    try {
      const section = document.getElementById(id);
      const track = document.getElementById(trackId);
      const wall = document.getElementById(wallId);
      const title = document.getElementById(titleId);
      if (!section || !track || !wall || !title) return;
      const cards = [...wall.querySelectorAll('.project-card')];
      if (!cards.length) return;

      let maxX = 0;

      function measureTitle() {
        const oL = title.style.left, oT = title.style.top, oV = title.style.visibility;
        title.style.left = '0px'; title.style.top = '0px'; title.style.visibility = 'hidden';
        const w = title.offsetWidth;
        title.style.left = oL; title.style.top = oT; title.style.visibility = oV;
        return w;
      }

      function layout() {
        const vw = window.innerWidth, vh = window.innerHeight, PAD = 80;
        const titleW = measureTitle();
        const titleX = Math.max(PAD, (vw - titleW) / 2);
        const titleY = (vh / 2) - 60;
        title.style.position = 'absolute';
        title.style.left = titleX + 'px';
        title.style.top = titleY + 'px';
        const titleRight = titleX + titleW + 120;
        const yPad = 60;
        let maxRight = 0;
        const layouts = [
          { w: 260, h: 340, x: titleRight + 160, y: yPad + 400, rot: 0, z: 11 },
          { w: 240, h: 295, x: titleRight + 240, y: yPad + 15, rot: 0, z: 11 },
          { w: 600, h: 700, x: titleRight + 470, y: (vh - 650) / 2, rot: 0, z: 9 },
          { w: 250, h: 360, x: titleRight + 1080, y: (vh - 630) / 2, rot: 0, z: 9 },
          { w: 190, h: 290, x: titleRight + 1130, y: (vh + 200) / 2, rot: 0, z: 9 },
          { w: 360, h: 280, x: titleRight + 1320, y: (vh - 50) / 2, rot: 0, z: 9 },
          { w: 300, h: 300, x: titleRight + 1500, y: (vh - 640) / 2, rot: 0, z: 9 },
          { w: 450, h: 650, x: titleRight + 1800, y: (vh - 600) / 2, rot: 0, z: 9 },
          { w: 250, h: 250, x: titleRight + 2300, y: (vh + 200) / 2, rot: 0, z: 9 },
          { w: 350, h: 250, x: titleRight + 2280, y: (vh - 535) / 2, rot: 0, z: 9 },
        ];
        cards.forEach((card, i) => {
          const l = i < layouts.length ? layouts[i] : { ...layouts[layouts.length - 1], x: layouts[layouts.length - 1].x + (i - layouts.length + 1) * 320, y: layouts[layouts.length - 1].y + ((i - layouts.length + 1) % 2 === 0 ? 0 : 120), rot: 0, z: 9 };
          maxRight = Math.max(maxRight, l.x + l.w);
          card.style.position = 'absolute';
          card.style.display = 'flex';
          card.style.left = l.x + 'px';
          card.style.top = l.y + 'px';
          card.style.width = l.w + 'px';
          card.style.height = l.h + 'px';
          card.style.zIndex = l.z;
          card.style.rotate = l.rot + 'deg';
        });
        const mw = Math.max(maxRight + PAD, vw + 100);
        wall.style.width = mw + 'px';
        wall.style.height = '100vh';
        maxX = Math.max(0, mw - vw);
        cards.forEach(card => {
          const cx = parseFloat(card.style.left);
          const cw = parseFloat(card.style.width);
          const rawStart = maxX > 0 ? (cx - vw + cw * 0.3) / maxX : 0;
          const start = Math.max(0, Math.min(rawStart, 0.5));
          card.dataset.animStart = start;
          card.dataset.animEnd = Math.min(1, start + 0.5);
        });
      }

      function update() {
        const vh = window.innerHeight;
        const rect = section.getBoundingClientRect();
        const sh = section.offsetHeight;
        const total = sh - vh;
        if (total <= 0) return;
        const scrolled = Math.max(0, Math.min(total, -rect.top));
        const progress = scrolled / total;
        track.style.transform = `translateX(${-progress * maxX}px)`;
        cards.forEach(card => {
          const s = parseFloat(card.dataset.animStart) || 0;
          const e = parseFloat(card.dataset.animEnd) || 0.1;
          const range = e - s;
          let p;
          if (range <= 0) { p = progress >= s ? 1 : 0; }
          else { p = Math.max(0, Math.min(1, (progress - s) / range)); }
          const ease = 1 - Math.pow(1 - p, 4);
          card.style.transform = `translateX(${550 - 550 * ease}px) rotate(${12 - 12 * ease}deg)`;
        });
      }

      layout();
      update();
      scroll(update, { container: document.documentElement });
      window.addEventListener('resize', () => { layout(); update(); });
    } catch (e) {
      console.error('Cert mural init error:', e);
    }
  }

  function poll() {
    const wrap = document.getElementById('crt-wrap');
    if (!wrap || (wrap.offsetParent === null && wrap.getClientRects().length === 0)) {
      requestAnimationFrame(poll);
      return;
    }
    if (initialized) return;
    initialized = true;
    initOne('crt-tech', 'crt-track-tech', 'crt-wall-tech', 'crt-title-tech');
    initOne('crt-lead', 'crt-track-lead', 'crt-wall-lead', 'crt-title-lead');
  }

  poll();
  document.addEventListener('certs-visible', poll);
</script>
