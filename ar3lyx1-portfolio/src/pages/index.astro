---
import '../home/infrastructure/ui/styles/boot.css';
import '../styles/variables-css/_colors.scss';
import SiteHead from '../components/SiteHead.astro';
import WorkSection from '../components/WorkSection.astro';
import ContactSection from '../components/ContactSection.astro';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&family=VT323&display=swap" rel="stylesheet">
  </head>
  <body style="margin:0; background:#000; overflow:hidden;">
    <div id="boot-screen" class="boot-screen">
      <div id="boot-output" class="boot-output"></div>
    </div>

    <div id="video-container" style="display:none; position:fixed; inset:0; z-index:50; background:#000;">
      <video id="staticVideo" src="/Static_Screen.mp4" muted autoplay playsinline style="width:100%; height:100%; object-fit:cover;"></video>
    </div>

    <div id="model-container" style="display:none; position:fixed; inset:0; z-index:75;"></div>

    <div id="sitehead-container" style="display:none;">
      <SiteHead />
    </div>

    <div id="portfolio-title" style="display:none; margin-top:40px; padding-left:5%; background:#fff; color:#1f1f1f; font-family: 'Ubuntu', monospace; font-weight: 800; letter-spacing:.15em;">
      <div id="title-line" style="display:flex; align-items:baseline; gap:15rem;">
        <div id="title-text" style="font-size:clamp(3.5rem,9.5vw,7.5rem); font-weight: 900; height: 0.4em; min-height: 1em; line-height:1; overflow:hidden;"></div>
        <div id="title-sub" style="font-size:clamp(1.25rem,2.5vw,1.75rem); font-weight:700; height: 0.4em; min-height: 1em; line-height:1; overflow:hidden; color:#1f1f1f;"></div>
      </div>
      <div id="title-text-2" style="font-size:clamp(3.5rem,9.5vw,7.5rem); font-weight: 900; height: 0.4em; min-height: 1em; line-height:1; overflow:hidden;"></div>
      <div id="title-title" style="font-size:clamp(3.5rem,9.5vw,7.5rem); font-weight: 900; height: 0.4em; min-height: 1em; line-height:1; overflow:hidden; color:#8a0606;"></div>

      <div id="title-phrase" style="font-size:clamp(3.75rem,6vw,4.5rem); font-style: italic; font-weight: 600; overflow:hidden; height: 0.4em; min-height: 1em; line-height:1; margin-top: 0.5rem;"></div>
      <div id="title-phrase-2" style="font-size:clamp(3.75rem,6vw,4.5rem); font-style: italic; font-weight: 600; overflow:hidden; height: 0.4em; min-height: 1em; line-height:1; margin-top: 0.5rem;"></div>
      <div id="title-autor" style="font-size:clamp(3.55rem,5.7vw,4.3rem); font-style: italic; font-weight: 600; overflow:hidden; height: 0.4em; min-height: 1em; line-height:1; margin-top: 0.5rem;"></div>
    </div>

    <div id="work-wrapper" style="display:none;">
      <WorkSection />
    </div>

    <div id="contact-wrapper" style="display:none;">
      <ContactSection />
    </div>

    <div id="white-top" style="position:fixed; top:0; left:0; right:0; height:0; background:#fff; z-index:100;"></div>
    <div id="white-bottom" style="position:fixed; bottom:0; left:0; right:0; height:0; background:#fff; z-index:100;"></div>
    <div id="white-left" style="position:fixed; left:0; top:0; bottom:0; width:0; background:#fff; z-index:100;"></div>
    <div id="white-right" style="position:fixed; right:0; top:0; bottom:0; width:0; background:#fff; z-index:100;"></div>
  </body>
</html>

<script>
  import { animate } from 'motion';
  import('../home/infrastructure/ui/scripts/boot.js');
  import { MODELS } from '../home/application/model-viewer/config.js';

  function animateTextById(id, text, duration = 0.7, charDelay = 0.09) {
    const el = document.getElementById(id);
    if (!el) return;
    const content = text ?? '';
    el.innerHTML = '';
    let specialWrapper = null;
    content.split('').forEach((char, index) => {
      if (id === 'title-text' && content === 'ANDRY' && char === 'D') {
        const wrapper = document.createElement('span');
        wrapper.style.display = 'inline-flex';
        wrapper.style.alignItems = 'center';
        wrapper.style.justifyContent = 'center';
        wrapper.style.position = 'relative';
        wrapper.style.transform = 'translateY(-103%)';
        const original = document.createElement('span');
        original.innerText = 'D';
        original.style.opacity = '1';
        const replacement = document.createElement('span');
        replacement.innerText = '☾︎';
        replacement.style.position = 'absolute';
        replacement.style.inset = '0';
        replacement.style.display = 'flex';
        replacement.style.alignItems = 'center';
        replacement.style.justifyContent = 'center';
        replacement.style.opacity = '0';
        replacement.style.pointerEvents = 'none';
        original.style.lineHeight = '1';
        wrapper.appendChild(original);
        wrapper.appendChild(replacement);
        el.appendChild(wrapper);
        specialWrapper = { wrapper, original, replacement, index };
        return;
      }
      const span = document.createElement('span');
      span.innerText = char === ' ' ? '\u00A0' : char;
      span.style.display = 'inline-block';
      span.style.transform = 'translateY(-103%)';
      el.appendChild(span);
    });
    Array.from(el.children).forEach((child, index) => {
      const dropDelay = index * charDelay;
      animate(child, { transform: 'translateY(0%)' }, { duration, delay: dropDelay, easing: 'linear' });
      if (child === specialWrapper?.wrapper) {
        const { original, replacement } = specialWrapper;
        const revealDelay = dropDelay + duration + 0.15;
        const fadeDuration = 0.2;
        const visibleDuration = 0.4;
        const loopDuration = fadeDuration * 2 + visibleDuration;
        const pFadeIn = fadeDuration / loopDuration;
        const pHold = (fadeDuration + visibleDuration) / loopDuration;
        animate(original, [
          { opacity: 1, offset: 0 },
          { opacity: 0, offset: pFadeIn },
          { opacity: 0, offset: pHold },
          { opacity: 1, offset: 1 }
        ], { duration: loopDuration, delay: revealDelay, repeat: Infinity, easing: 'ease-in-out' });
        animate(replacement, [
          { opacity: 0, offset: 0 },
          { opacity: 1, offset: pFadeIn },
          { opacity: 1, offset: pHold },
          { opacity: 0, offset: 1 }
        ], { duration: loopDuration, delay: revealDelay, repeat: Infinity, easing: 'ease-in-out' });
      }
    });
  }

  function animateDrop(el, html) {
    el.innerHTML = '';
    const parts = html.split('<br>');
    parts.forEach((part, pi) => {
      if (pi > 0) el.appendChild(document.createElement('br'));
      const indent = part.startsWith('_> [');
      [...part].forEach((char, ci) => {
        const span = document.createElement('span');
        span.textContent = char === ' ' ? '\u00A0' : char;
        span.style.display = 'inline-block';
        span.style.transform = 'translateY(-103%)';
        if (ci === 0 && indent) span.style.marginLeft = '1.8em';
        el.appendChild(span);
      });
    });
    const chars = [...el.children].filter(c => c.tagName !== 'BR');
    chars.forEach((child, idx) => {
      animate(child, { transform: 'translateY(0%)' }, { duration: 0.5, delay: idx * 0.04, easing: 'linear' });
    });
  }

  window.addEventListener('bootComplete', async () => {
    const videoContainer = document.getElementById('video-container');
    const video = document.getElementById('staticVideo');
    const topPanel = document.getElementById('white-top');
    const bottomPanel = document.getElementById('white-bottom');
    const leftPanel = document.getElementById('white-left');
    const rightPanel = document.getElementById('white-right');
    const modelContainer = document.getElementById('model-container');

    const modelModulePromise = import('../home/infrastructure/ui/viewer/ModelViewer.js');

    videoContainer.style.display = 'block';
    video.currentTime = 3.5;
    video.play();

    await new Promise(r => setTimeout(r, 1200));

    const gap = 80;
    const topTarget = (window.innerHeight / 2) - (gap / 2);
    const bottomTarget = (window.innerHeight / 2) - (gap / 2);
    const leftTarget = (window.innerWidth / 2) - (gap / 2);
    const rightTarget = (window.innerWidth / 2) - (gap / 2);

    await Promise.all([
      animate(topPanel, { height: topTarget + 'px' }, { duration: 1.5, easing: [0.4, 0, 0.2, 1] }).finished,
      animate(bottomPanel, { height: bottomTarget + 'px' }, { duration: 1.5, easing: [0.4, 0, 0.2, 1] }).finished,
      animate(leftPanel, { width: leftTarget + 'px' }, { duration: 1.5, easing: [0.4, 0, 0.2, 1] }).finished,
      animate(rightPanel, { width: rightTarget + 'px' }, { duration: 1.5, easing: [0.4, 0, 0.2, 1] }).finished,
    ]);

    modelContainer.style.display = 'block';
    const setupPromise = (async () => {
      const { initModelViewer } = await modelModulePromise;
      return initModelViewer(modelContainer, MODELS);
    })();

    await new Promise(r => setTimeout(r, 0));

    await Promise.all([
      animate(topPanel, { height: '50%' }, { duration: 0.4, easing: 'ease-in' }).finished,
      animate(bottomPanel, { height: '50%' }, { duration: 0.4, easing: 'ease-in' }).finished,
      animate(leftPanel, { width: '50%' }, { duration: 0.4, easing: 'ease-in' }).finished,
      animate(rightPanel, { width: '50%' }, { duration: 0.4, easing: 'ease-in' }).finished,
    ]);

    document.body.style.background = '#fff';
    document.documentElement.style.background = '#fff';
    videoContainer.style.display = 'none';
    topPanel.style.display = 'none';
    bottomPanel.style.display = 'none';
    leftPanel.style.display = 'none';
    rightPanel.style.display = 'none';
    const viewer = await setupPromise;

    setTimeout(async () => {
      const vhsEffect = viewer.startVHS();
      await new Promise(r => setTimeout(r, 1000));
      viewer.stopVHS();
      if (viewer && viewer.dispose) viewer.dispose();
      modelContainer.style.display = 'none';

      const titleDiv = document.getElementById('portfolio-title');

      titleDiv.style.display = 'block';
      titleDiv.style.opacity = '0';
      animateTextById('title-text', 'ANDRY');
      animateTextById('title-sub', '>_AR3LYX1', 0.7, 0.15);
      animateTextById('title-text-2', 'CACERES');
      animateTextById('title-title', 'SOFTWARE DEV');
      animateTextById('title-phrase', "\"Software is like sex:", 0.28);
      animateTextById('title-phrase-2', "it's better when it's free.\"",0.28);
      animateTextById('title-autor', " - Linus Torvalds -");
      titleDiv.style.opacity = '1';

      setTimeout(() => {
        document.body.style.overflow = 'auto';
        document.documentElement.style.overflow = 'auto';
        const headContainer = document.getElementById('sitehead-container');
        headContainer.style.display = 'block';
        const workEl = document.getElementById('work-wrapper');
        if (workEl) workEl.style.display = 'block';
        const contactEl = document.getElementById('contact-wrapper');
        if (contactEl) contactEl.style.display = 'block';
        // grid init
        const grid = document.getElementById('ws-grid');
        if (grid) {
          const items = [...grid.querySelectorAll('.ws-item')];
          const back = document.getElementById('ws-back');
          let expanded = null;

          const binaryLabels = {};
          items.forEach(i => {
            const h3 = i.querySelector('.ws-front h3');
            if (h3) binaryLabels[i.dataset.col + i.dataset.row] = h3.innerHTML;
          });

          function flipAnimate(el, toCol, toRow) {
            const first = el.getBoundingClientRect();
            el.style.gridColumn = toCol;
            el.style.gridRow = toRow;
            const last = el.getBoundingClientRect();
            const dx = first.left - last.left;
            const dy = first.top - last.top;
            const sx = first.width / last.width;
            const sy = first.height / last.height;
            return new Promise(r => {
              const anim = el.animate([
                { transform: `translate(${dx}px, ${dy}px) scaleX(${sx}) scaleY(${sy})` },
                { transform: 'translate(0,0) scaleX(1) scaleY(1)' }
              ], { duration: 600, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' });
              anim.onfinish = r;
              anim.oncancel = r;
            });
          }

          function setFrontText(item, text, animate = false) {
            const h3 = item.querySelector('.ws-front h3');
            if (!h3) return;
            const html = text.replace(/_> /g, '<br>_> ').replace(/^<br>/, '');
            if (animate) {
              animateDrop(h3, html);
            } else {
              h3.innerHTML = html;
            }
          }

          function collapse() {
            if (!expanded) return;
            const el = expanded;
            expanded = null;
            const col = el.dataset.col;
            const row = el.dataset.row;
            el.classList.remove('expanding');
            items.forEach(i => {
              i.style.gridColumn = '';
              i.style.gridRow = '';
              const f = i.querySelector('.ws-front');
              if (f) {
                f.classList.remove('small');
                f.style.opacity = '';
              }
              const key = i.dataset.col + i.dataset.row;
              if (binaryLabels[key]) {
                const h3 = i.querySelector('.ws-front h3');
                if (h3) h3.innerHTML = binaryLabels[key];
              }
            });
            const expand = el.querySelector('.ws-expand');
            const frontEl = el.querySelector('.ws-front h3');
            if (expand) expand.classList.remove('visible');
            if (back) back.classList.remove('visible');
            flipAnimate(el, col, row).then(() => {
              if (frontEl) frontEl.style.opacity = '1';
            });
          }

          items.forEach(item => {
            item.addEventListener('click', async () => {
              if (expanded === item) { collapse(); return; }
              if (expanded) return;

              items.forEach(i => {
                const front = i.querySelector('.ws-front');
                if (front) front.classList.remove('small');
                const key = i.dataset.col + i.dataset.row;
                if (binaryLabels[key]) setFrontText(i, binaryLabels[key]);
              });

              const col = parseInt(item.dataset.col);
              const row = parseInt(item.dataset.row);
              const expandText = item.dataset.expand;
              const front = item.querySelector('.ws-front h3');
              const expand = item.querySelector('.ws-expand');
              if (expand && expandText) expand.textContent = expandText;

              // replace other items' front text with smaller labels
              const replaces = [item.dataset.r1, item.dataset.r2, item.dataset.r3, item.dataset.r4];
              if (replaces.some(r => r)) {
                const targets = items.filter(i => i !== item);
                targets.forEach((t, idx) => {
                  if (replaces[idx]) {
                    setFrontText(t, replaces[idx], true);
                    const ft = t.querySelector('.ws-front');
                    if (ft) ft.classList.add('small');
                  }
                });
              }

              if (front) front.style.opacity = '0';
              if (back) back.classList.add('visible');

              const leftSide = col === 1 || (col === 2 && row === 1);
              const targetCol = leftSide ? '1 / 3' : '2 / 4';
              const targetRow = '1 / 3';

              await flipAnimate(item, targetCol, targetRow);
              item.classList.add('expanding');

              if (expand) expand.classList.add('visible');
              expanded = item;
            });
          });
          if (back) back.addEventListener('click', collapse);
        }
        // VHS static for binary separators
        function vhsStatic(containerSelector) {
          const spans = document.querySelectorAll(`${containerSelector} span`);
          if (!spans.length) return;
          function scramble() {
            const n = 1 + Math.floor(Math.random() * 3);
            for (let i = 0; i < n; i++) {
              const idx = Math.floor(Math.random() * spans.length);
              const cur = spans[idx].textContent;
              const flip = cur === '0' ? '1' : '0';
              spans[idx].textContent = flip;
              spans[idx].style.opacity = '0.6';
              setTimeout(() => {
                spans[idx].textContent = cur;
                spans[idx].style.opacity = '1';
              }, 60 + Math.random() * 120);
            }
          }
          setInterval(scramble, 80 + Math.random() * 120);
        }
        vhsStatic('.ws-sep');
        vhsStatic('.cs-sep');
        setTimeout(() => {
          document.dispatchEvent(new CustomEvent('intro'));
        }, 300);
      }, 300);
    }, 2500);
  });
</script>


